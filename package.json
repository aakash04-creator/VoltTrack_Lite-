{
  "name": "volttrack-lite",
  "version": "1.0.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "node Script/dev.js",
    "dev:server": "node Backend/index.js",
    "dev:client": "vite --config frontend/vite.config.js --host 127.0.0.1",
    "start": "node Backend/index.js",
    "seed": "node Backend/Database/seed.js",
    "test": "jest --runInBand",
    "build": "vite --config frontend/vite.config.js build",
    "preview": "vite --config frontend/vite.config.js preview --host 127.0.0.1",
    "electron:dev": "node Script/dev-electron.js",
    "electron:build": "vite --config frontend/vite.config.js build && electron-builder",
    "electron:build:mac": "vite --config frontend/vite.config.js build && electron-builder --mac",
    "electron:build:win": "vite --config frontend/vite.config.js build && electron-builder --win",
    "electron:build:dir": "vite --config frontend/vite.config.js build && electron-builder --dir"
  },
  "build": {
    "appId": "com.volttrack.lite",
    "productName": "VoltTrack Lite",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "electron/assets/icon.icns",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "electron/assets/icon.png",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "icon": "electron/assets/icon.png",
      "target": [
        "AppImage",
        "deb"
      ]
    }
  },
  "dependencies": {
    "axios": "^1.7.9",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "csv-parse": "^5.6.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^1.72.0",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.13.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hot-toast": "^2.5.2",
    "react-router-dom": "^6.28.1",
    "recharts": "^2.15.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.9",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^6.0.5",
    "wait-on": "^9.5.1"
  }
}
